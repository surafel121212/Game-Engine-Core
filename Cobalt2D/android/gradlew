##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh does
#       not find so, but you have some other POSIX shell available, try using that
#       instead.
#   (2) Now that the script is executing, be careful to "unset" `args` since
#       that variable may mean something different if a parent script uses "set args".
#
##############################################################################

# To recompile the generated wrapper Java class, remove the ".gradlew" and
# "gradle-wrapper.jar" files, then run the gradle build.

PROG="$0"
# Need this for relative symlinks.
while [ -h "$PROG" ] ; do
    ls=`ls -ld "$PROG"`
    link=`expr "$ls" : '.*-> \(.*\)$'`
    if expr "$link" : '/.*' > /dev/null; then
        PROG="$link"
    else
        PROG=`dirname "$PROG"`"/$link"
    fi
done

savedir=`pwd`

cd "`dirname \"$PROG\"`" >/dev/null
appdir=`pwd -P`
cd "$savedir" >/dev/null

DEFAULT_JVM_OPTS=""
JAVA_OPTS=(`echo "$JAVA_OPTS" | tr ' ' '\n' | sed 's/^/-J/'`)

# Add default options if needed
for opt in "${JAVA_OPTS[@]}" ; do
    if [ "${opt:0:2}" != "-J" ] && [ -n "$opt" ] ; then
        DEFAULT_JVM_OPTS="$DEFAULT_JVM_OPTS \"$opt\""
    fi
done

exec "$appdir/gradle/wrapper/gradlew" "$@"
